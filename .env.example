# ClinKey environment configuration
# Copy to ".env" and fill in what you need. NEVER commit real secrets.

# Google Gemini (translation / safety / routing / generation).
# Empty = self-contained demo mode.
GEMINI_API_KEY=

# The Streamlit demo app sets this automatically on startup so it never
# crashes when sentence-transformers isn't installed (hash-embedding demo
# fallback). Set explicitly only if you invoke the pipeline outside the
# Streamlit app (scripts, tests) and want the same fallback there.
# CLINKEY_ALLOW_HASH=1